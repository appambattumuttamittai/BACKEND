# Backend Environment Variables
# Copy this file to .env and fill in your values

DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://appambattumuttamittai.com

# Admin credentials (never hardcode - set in Render dashboard)
ADMIN_USERNAME=admin
# Generate hash with: node -e "const argon2=require('argon2'); argon2.hash('yourpassword').then(console.log)"
ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$REPLACE_WITH_REAL_HASH
# Random string, min 32 chars
ADMIN_SESSION_SECRET=replace-with-random-secret-min-32-characters-long

# OTP Provider selection: 'firebase' (default, for testing/dev) or 'msg91' (for production) or 'twilio'
OTP_PROVIDER=firebase

# Firebase Authentication (Testing / Development)
# Set FIREBASE_TEST_MODE=true to test OTP without sending real SMS (default test OTP: 123456)
FIREBASE_TEST_MODE=true
FIREBASE_TEST_OTP=123456
# Optional: Set real Firebase Web API Key for live Firebase Phone Auth
FIREBASE_API_KEY=AIzaSy...your-web-api-key
FIREBASE_PROJECT_ID=your-firebase-project-id

# MSG91 (Production SMS & OTP Gateway)
# Switch OTP_PROVIDER=msg91 when deploying to production
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_msg91_dlt_template_id_here
MSG91_OTP_EXPIRY_MINUTES=10

# Twilio OTP (Alternative fallback)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram Notifications
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# Google Sheets (paste full service account JSON as single line)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GOOGLE_SHEETS_SPREADSHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms
GOOGLE_SHEETS_SHEET_NAME=Orders
GOOGLE_SHEETS_URL=https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit

# Optional: Override GPay QR image URL (leave empty to use frontend default)
QR_IMAGE_URL=

# Razorpay Payment Gateway (Add in Render Dashboard)
# Get these from your Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
