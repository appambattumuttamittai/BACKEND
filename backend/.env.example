# Backend Environment Variables
# Copy this file to .env and fill in your values

DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://appambattumuttamittai.com

# Admin credentials (never hardcode - set in Render dashboard)
ADMIN_USERNAME=admin
# Generate hash with: node -e "const argon2=require('argon2'); argon2.hash('yourpassword').then(console.log)"
ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$REPLACE_WITH_REAL_HASH
# Random string, min 32 chars
ADMIN_SESSION_SECRET=replace-with-random-secret-min-32-characters-long

# Twilio OTP
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram Notifications
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# Google Sheets (paste full service account JSON as single line)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GOOGLE_SHEETS_SPREADSHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms
GOOGLE_SHEETS_SHEET_NAME=Orders
GOOGLE_SHEETS_URL=https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit

# Optional: Override GPay QR image URL (leave empty to use frontend default)
QR_IMAGE_URL=
