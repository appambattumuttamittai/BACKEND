    "axios": "^1.7.2",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "google-auth-library": "^9.13.0",
    "googleapis": "^140.0.1",
    "twilio": "^5.2.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.11",
    "prisma": "^5.16.0",
